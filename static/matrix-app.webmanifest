{
  "id": "/matrix-immersive",
  "name": "Systems & Signals",
  "short_name": "Signals",
  "description": "A focused workspace for Matrix, Focus Radio, and a local Frequency Lab.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#080b09",
  "theme_color": "#080b09",
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "categories": ["developer", "music", "productivity", "personalization"],
  "icons": [
    {
      "src": "/icons/farokh-app.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/farokh-app-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/farokh-app-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Matrix Immersive",
      "short_name": "Matrix",
      "description": "Open the fullscreen digital-rain experience.",
      "url": "/app/?matrix=immersive&app=matrix-shortcut",
      "icons": [{ "src": "/icons/farokh-app-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Focus Radio",
      "short_name": "Radio",
      "description": "Open the streaming focus-music player.",
      "url": "/app/?focus=open&audio=radio&app=radio",
      "icons": [{ "src": "/icons/shortcut-radio-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Frequency Lab",
      "short_name": "Frequencies",
      "description": "Open the local Solfeggio and stereo-beat generator.",
      "url": "/app/?focus=open&audio=frequency&app=frequency",
      "icons": [{ "src": "/icons/shortcut-frequency-96.png", "sizes": "96x96", "type": "image/png" }]
    }
  ]
}
